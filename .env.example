# Copy to server/.env for local development.
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/shopback_todo
CLIENT_ORIGIN=http://localhost:5173

# Optional only when the client and API are hosted on different origins.
# Local Vite and the Netlify deployment both use same-origin /api requests.
VITE_API_URL=http://localhost:5000/api
